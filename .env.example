# PostgreSQL connection string supplied by your hosted database provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"
PORT=4000
FRONTEND_URL="http://localhost:8080"
# Optional comma-separated preview or production frontend origins.
ALLOWED_ORIGINS=""
JWT_SECRET="replace-with-at-least-32-random-characters"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
PUBLIC_API_URL="http://localhost:4000"
# Set true only when the API is behind a trusted reverse proxy (for example Render or Railway).
TRUST_PROXY="false"
# Use an absolute persistent-disk path in production when storing uploads locally.
UPLOAD_DIR="uploads"
# Required for persistent image/CV uploads when deployed on Vercel.
BLOB_READ_WRITE_TOKEN=""
